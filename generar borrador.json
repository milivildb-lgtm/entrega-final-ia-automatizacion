        "jsCode": "const items = $input.all();\nconst lines = items.map(i => {\n  const f = i.json.fields || i.json;\n  return `- ${f.Tema}: ${f.Contenido}`;\n});\nreturn [{ json: { contexto_rag: lines.join('\\n\\n') } }];"
